require "base64"

default_platform(:ios)

APP_ID = "com.acesinthesack.trivianight"

platform :ios do
  desc "Build a signed App Store build and upload it to TestFlight"
  lane :beta do
    team_id = ENV.fetch("APPLE_TEAM_ID")

    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_filepath: ENV.fetch("ASC_KEY_PATH")
    )

    # Temporary keychain on the CI runner
    setup_ci

    # App Store distribution certificate + profile, created through the API key on first
    # run and stored encrypted on this repo's `match-certificates` branch afterwards.
    # No registered devices are needed for App Store signing.
    match(
      type: "appstore",
      app_identifier: APP_ID,
      team_id: team_id,
      api_key: api_key,
      storage_mode: "git",
      git_url: "https://github.com/#{ENV.fetch('GITHUB_REPOSITORY')}.git",
      git_branch: "match-certificates",
      git_basic_authorization: Base64.strict_encode64("x-access-token:#{ENV.fetch('GITHUB_TOKEN')}"),
      readonly: false
    )

    profile_name = ENV.fetch("sigh_#{APP_ID}_appstore_profile-name")

    update_code_signing_settings(
      path: "TriviaNight.xcodeproj",
      use_automatic_signing: false,
      team_id: team_id,
      targets: ["TriviaNight"],
      bundle_identifier: APP_ID,
      code_sign_identity: "Apple Distribution",
      profile_name: profile_name
    )

    build_app(
      project: "TriviaNight.xcodeproj",
      scheme: "TriviaNight",
      configuration: "Release",
      export_method: "app-store",
      output_directory: ".",
      output_name: "TriviaNight.ipa",
      xcargs: "CURRENT_PROJECT_VERSION=#{ENV.fetch('BUILD_NUMBER', '1')}",
      export_options: {
        provisioningProfiles: { APP_ID => profile_name }
      }
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )
  end
end
