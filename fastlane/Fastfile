default_platform(:ios)

platform :ios do
  desc "Build a signed App Store build and upload it to TestFlight"
  lane :beta do
    key_path = ENV.fetch("ASC_KEY_PATH")
    key_id = ENV.fetch("ASC_KEY_ID")
    issuer_id = ENV.fetch("ASC_ISSUER_ID")
    team_id = ENV.fetch("APPLE_TEAM_ID")

    api_key = app_store_connect_api_key(
      key_id: key_id,
      issuer_id: issuer_id,
      key_filepath: key_path
    )

    # Xcode's cloud-managed automatic signing, authenticated with the API key.
    auth = "-allowProvisioningUpdates " \
           "-authenticationKeyPath #{key_path} " \
           "-authenticationKeyID #{key_id} " \
           "-authenticationKeyIssuerID #{issuer_id}"

    build_app(
      project: "TriviaNight.xcodeproj",
      scheme: "TriviaNight",
      configuration: "Release",
      export_method: "app-store",
      output_directory: ".",
      output_name: "TriviaNight.ipa",
      # Sign the archive for distribution directly; a development profile would need a registered device.
      xcargs: "#{auth} DEVELOPMENT_TEAM=#{team_id} CODE_SIGN_STYLE=Automatic CODE_SIGN_IDENTITY='Apple Distribution' CURRENT_PROJECT_VERSION=#{ENV.fetch('BUILD_NUMBER', '1')}",
      export_xcargs: auth,
      export_options: {
        signingStyle: "automatic",
        teamID: team_id
      }
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )
  end
end
